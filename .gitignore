# Toolchain downloads (run setup scripts to get these)
platform-tools/
android-sdk/
jdk/
# Signing keys - NEVER commit these. Remove debug.keystore from tracking:
#   git rm --cached debug.keystore
# For release builds, supply KIOSK_KEYSTORE / KIOSK_KEYSTORE_PASS via env or CI secrets.
*.keystore

# Build artifacts (keep only the final APK)
dist/
build/CU-Denver-Equity-Kiosk-Manager/
build/gen/
build/obj/
build/*-aligned.apk
build/*-unaligned.apk
build/*.idsig
*.spec
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temp files
/tmp/
*.zip
*.tmp
