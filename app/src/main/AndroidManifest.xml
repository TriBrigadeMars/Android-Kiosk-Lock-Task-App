<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.webkiosk">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- WiFi connection on Android 13+ (Android 15 tablet) -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- WiFi connection on Android 10-12 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:label="CU Denver Equity"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <!-- Main kiosk activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:lockTaskMode="if_whitelisted">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WiFi credential management (opened from launcher or kiosk app) -->
        <activity
            android:name=".WifiSettingsActivity"
            android:exported="false"
            android:lockTaskMode="if_whitelisted" />

        <!-- Custom launcher — only shows the kiosk app -->
        <activity
            android:name=".kiosklauncher.LauncherActivity"
            android:exported="true"
            android:label="Kiosk Launcher"
            android:lockTaskMode="if_whitelisted">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
